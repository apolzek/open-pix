# =============================================================================
# Pix Homologation Environment Configuration
# Copy this file to .env and fill in your PSP-specific values
# =============================================================================

# --- PSP Identity ---
PSP_ISPB=12345678                    # Your ISPB, 8 chars [0-9A-Z]
PSP_NAME="My PSP"                    # PSP display name
PSP_PARTICIPANT_TYPE=DIRETO          # DIRETO or INDIRETO

# --- ICOM Connection (SPI) ---
# Primary channel. Secondary (scheduled Pix, gzip mandatory):
# https://icom-sec-h.pi.rsfn.net.br:17522
ICOM_BASE_URL=https://icom-h.pi.rsfn.net.br:16522
# Send:    POST /api/v1/in/${PSP_ISPB}/msgs
# Receive: GET  /api/v1/out/${PSP_ISPB}/stream/start, then PI-Pull-Next,
#          and DELETE the last PI-Pull-Next when done

# --- mTLS Certificates ---
MTLS_CERT_PATH=./certs/client.pem    # Client certificate (PEM)
MTLS_KEY_PATH=./certs/client-key.pem # Client private key (PEM)
MTLS_CA_PATH=./certs/ca-chain.pem    # CA chain (RSFN root + intermediaries)
MTLS_PASSPHRASE=                     # Private key passphrase (if encrypted)

# --- DICT API ---
DICT_BASE_URL=https://dict-h.pi.rsfn.net.br:16522   # API under /api/v2/
DICT_API_VERSION=v2

# --- Bacen Test Environment ---
SPI_ISPB=00038166                    # SPI itself (Bacen): AppHdr/To of every message you send
BACEN_VIRTUAL_CREDITOR_ISPB=99999A04 # Virtual credit union: answers any pacs.008 with ACSP
BACEN_VIRTUAL_DEBTOR_ISPB=99999A03   # Virtual bank: sends pacs.008 in the receiving tests
# BACEN_DICT_ISPB=99999060           # Seen in practice; not in any official Bacen document

# --- Partner PSP (for bilateral tests) ---
PARTNER_ISPB=                        # Partner PSP ISPB
PARTNER_NAME=                        # Partner PSP name

# --- PI Account ---
PI_ACCOUNT_BRANCH=0001               # Branch at Bacen
PI_ACCOUNT_NUMBER=                   # PI account number

# --- HTTP Client Tuning ---
HTTP_MAX_SOCKETS=50                  # Max concurrent TCP connections
HTTP_KEEPALIVE=true                  # TCP keepAlive
HTTP_TIMEOUT_MS=30000                # Request timeout
HTTP_POLL_CONNECTIONS=6              # Max ICOM read streams per channel (above: 429)

# --- Load Test Parameters ---
SPI_CAPACITY_RATE=2000               # Per minute: 1000 (<=1M accounts), 2000 (<=10M), 4000 (>10M)
SPI_CAPACITY_DURATION=10m            # Test duration
DICT_CAPACITY_LOOKUPS=1000           # Minimum key lookups

# --- Logging ---
LOG_LEVEL=info                       # debug, info, warn, error
LOG_FORMAT=json                      # json or text
